# Environment variables for GCP Streaming Project
# Copy this file to .env and fill in your values

# Required: Your GCP Project ID
GCP_PROJECT_ID=your-project-id-here

# Optional: Pub/Sub topic name (default: banking-transactions)
PUBSUB_TOPIC_ID=banking-transactions

# Optional: Transactions per second (default: 2)
TPS=2

# Optional: Path to service account key (if not using default credentials)
# GOOGLE_APPLICATION_CREDENTIALS=terraform/service-account-key.json